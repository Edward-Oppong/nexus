# ============================================================
# Nexus Clinical Workstation — Environment Configuration
# Replace all REPLACE_ME values before deployment.
# Never commit real secrets to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Your Supabase project URL and anon key.
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=https://vtotfliptcdfoinrvlpg.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME_WITH_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KHb37590vuhGQZcOhKchDw_VynXyetk

# ── Hugging Face Inference API ───────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
# Requires a Pro or Inference API subscription for production throughput.
# Without this, Nexus falls back to deterministic stubs (no live AI).
VITE_HF_API_TOKEN=REPLACE_ME_WITH_HF_TOKEN

# ── App Environment ──────────────────────────────────────────
# Set to "production" on live deployments.
VITE_APP_ENV=development
